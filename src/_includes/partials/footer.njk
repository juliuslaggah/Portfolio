<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="brand brand-light"><span class="brand-mark">JL</span> {{ site.name }}</a>
      <p class="footer-note">Lecturer, Department of Information &amp; Communication Technology, Limkokwing University.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {%- for item in site.nav %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {{ site.year }} {{ site.name }}</span>
    <a href="{{ site.github }}" rel="me">GitHub</a>
  </div>
</footer>
