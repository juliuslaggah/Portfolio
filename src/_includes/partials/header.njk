<header class="nav" id="top">
  <div class="container nav-inner">
    <a href="/" class="brand"><span class="brand-mark">JL</span> {{ site.name }}</a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <nav id="nav-links" class="nav-links" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"
         class="{% if item.label == 'Contact' %}nav-cta{% endif %}"
         {% if page.url.startsWith(item.url) %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
