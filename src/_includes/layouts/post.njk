---
layout: base.njk
---
{#- Layout for a single blog-style post. Set automatically by each posts/ folder. -#}
<article class="post">
  <header class="page-hero page-hero-post">
    <div class="container narrow">
      <a class="back-link" href="{{ moduleUrl }}">← {{ moduleLabel }}</a>
      <h1>{{ title }}</h1>
      <p class="post-meta">
        <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
        <span class="pill">{{ moduleLabel }}</span>
      </p>
    </div>
  </header>
  {% if image %}
  <figure class="container narrow" style="margin-block:0">
    <img class="post-cover" src="{{ image }}" alt="{{ imageAlt or '' }}">
    {% if imageCaption %}<figcaption class="post-cover-caption">{{ imageCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="section">
    <div class="container narrow prose">
      {{ content | safe }}
    </div>
  </div>
  <div class="container narrow post-foot">
    <a class="btn btn-outline" href="{{ moduleUrl }}">← Back to {{ moduleLabel }}</a>
    <a class="text-link" href="/">Home →</a>
  </div>
</article>
